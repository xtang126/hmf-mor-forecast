[runtime]
sampler = emcee #emcee #test for a single-eval sanity check
root = ${PWD}
resume = F
verbosity = debug #quiet

[test]
save_dir = output/test/hmf_counts_v2
fatal_errors = T

[emcee]
walkers = 20              ; quick/rough run to check contour location; production: 40
samples = 500              ; quick/rough run (~25 steps/walker); production: 8000
#burn = 600 #do this in post-processing
#save_all_parameters = F
#output_every = 10
#proposal_scale = 1.0

#[maxlike] this can be used if we are doing a maxlike sampler not a emcee, if we want to find the quick best-fit without sampling, ask xin about it 
#output_ini = mf_xt/output/mf_manual_v1.ini
#tolerance = 1e-6

[output]
filename = output/scatter_free_v1.txt
format = text
lock = F
new_file = T

[pipeline]
modules = mass_function_like
values = configs/values.ini
likelihoods = hmf
;priors = mf_xt/priors_fit.ini
timing = T

[prior]
omega_m = uniform 0.1 0.5
sigma8_input = uniform 0.6 1.0

[mass_function_like]
file = likelihoods/hmf_mor_forecast.py

; redshift range + binning (typical X-ray cluster survey depth/cadence)
z_min      = 0.1
z_max      = 1.0
n_z_bins   = 9
area_deg2  = 4000.0

; mass range + binning (Msun/h)
mass_min    = 2e14
mass_max    = 5e15
n_mass_bins = 10

; fiducial (mock only)
Om0_fid    = 0.318
sigma8_fid = 0.80
h0_fid     = 0.7

; MOR knobs
alpha_MOR            = 1.0
frac_scatter_data    = 0.10    ; TRUE scatter in the mock
scatter_model_free = T
; frac_scatter_model = 0.10   ; used only if scatter_model_free = F